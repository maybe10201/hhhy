      "messages": [
        {
          "id": "6c7d15be-6893-46cd-99e1-644483521bad",
          "kind": "date",
          "text": "2017년 3월 9일 목요일",
          "dateParts": {
            "mode": "calendar",
            "year": 2017,
            "month": 3,
            "day": 9,
            "weekday": 4
          }
        },
        {
          "id": "e843e1d6-6609-41c2-97fb-64110dc04725",
          "from": "them",
          "text": "쏘리쏘리 2조 개인연습생 김재환입니다! 잘 부탁드립니다ㅎㅎ",
          "time": "16:59"
        },
        {
          "id": "489ddde9-b8dd-4e75-b932-39021947858e",
          "from": "me",
          "text": "플레디스 황민현입니다 잘 부탁드려요!",
          "time": "16:59"
        },
        {
          "id": "3bffd5f0-7a8b-4a59-b0e6-44f7cfda51cd",
          "kind": "date",
          "text": "2017년 6월 16일 금요일",
          "dateParts": {
            "mode": "calendar",
            "year": 2017,
            "month": 6,
            "day": 16,
            "weekday": 5
          }
        },
        {
          "id": "61e603c8-4cf2-4c1f-a1ff-562683926006",
          "from": "me",
          "text": "할 말 있어 녹화 끝나고 보자",
          "time": "17:01"
        },
        {
          "id": "dc6a7b14-95b4-47d0-8c80-b8adc7f77c1d",
          "kind": "date",
          "text": "2017년 8월 7일 월요일",
          "dateParts": {
            "mode": "calendar",
            "year": 2017,
            "month": 8,
            "day": 7,
            "weekday": 1
          }
        },
        {
          "id": "c46b63a3-78e1-40bb-bf1b-de3d25f31f20",
          "from": "them",
          "text": "형 데뷔 축하해요!! 앞으로도 잘 부탁해요",
          "time": "17:02"
        },
        {
          "id": "6e4e57ba-89c1-4abb-a20f-06571eed108b",
          "from": "me",
          "text": "재환이도 데뷔 축하해🤍",
          "time": "17:03"
        },
        {
          "id": "d7f390d7-0388-4f73-a3f6-4ec7c4bb34aa",
          "kind": "date",
          "text": "2019년 1월 26일 토요일",
          "dateParts": {
            "mode": "calendar",
            "year": 2019,
            "month": 1,
            "day": 26,
            "weekday": 6
          }
        },
        {
          "id": "ad0bd0ac-04b5-4a6c-a3a6-064691993761",
          "from": "them",
          "text": "형 진짜 고마워요 항상",
          "time": "17:05"
        },
        {
          "id": "8e8fec41-f15e-41de-90f8-2f7590dd2357",
          "kind": "date",
          "text": "2019년 1월 27일 일요일",
          "dateParts": {
            "mode": "calendar",
            "year": 2019,
            "month": 1,
            "day": 27,
            "weekday": 0
          }
        },
        {
          "id": "c9815b19-9b90-41fe-93e4-ebbe1aa1fe59",
          "from": "me",
          "text": "벌써 1년 반이라는 시간이 흘러서 오지 않았으면 하는 날이 왔네. 재환이랑 활동하는 동안 하루도 빠짐없이 행복했어 항상 고마워~ 우리는 꾸준히 만날 거지만, 한동안 이 순간이 그리울 것 같아 많이 사랑해 너무 많이 울지는 마",
          "time": "17:13"
        },
        {
          "id": "609408f9-fc71-49d8-92d9-5be9520ac9f7",
          "kind": "date",
          "text": "2021년 12월 11일 토요일",
          "dateParts": {
            "mode": "calendar",
            "year": 2021,
            "month": 12,
            "day": 11,
            "weekday": 6
          }
        },
        {
          "id": "18de24ac-8e54-4f8e-952e-c9401954008a",
          "from": "them",
          "text": "형 끝나고 고기 먹을래요?",
          "time": "17:17"
        },
        {
          "id": "1acc55e4-37dd-4b54-84bb-476b3d26305d",
          "from": "me",
          "text": "좋아",
          "time": "17:17"
        },
        {
          "id": "a8479413-e9f8-4e24-b130-39e690874091",
          "kind": "date",
          "text": "2024년 7월 1일 월요일",
          "dateParts": {
            "mode": "calendar",
            "year": 2024,
            "month": 7,
            "day": 1,
            "weekday": 1
          }
        },
        {
          "id": "5fb3d580-bcc7-4d75-8272-0cb680d0244d",
          "from": "me",
          "text": "보고 싶을 거야~ㅜㅜ",
          "time": "17:23"
        },
        {
          "id": "bf257c5d-f764-46e7-b1e6-afdec9fef301",
          "from": "them",
          "text": "놀리는 거죠...",
          "time": "17:23"
        },
        {
          "id": "07379515-7892-447f-96a7-c7eeaf28d303",
          "from": "me",
          "text": "진심이지🫶",
          "time": "17:24"
        },
        {
          "id": "099159ae-4949-4dfe-a9e5-f5ffe3e2dc5c",
          "kind": "date",
          "text": "2025년 12월 31일 수요일",
          "dateParts": {
            "mode": "calendar",
            "year": 2025,
            "month": 12,
            "day": 31,
            "weekday": 3
          }
        },
        {
          "id": "d7e7b581-3b62-4dbd-bc6e-e0bfbb65b3cb",
          "from": "me",
          "text": "전역 축하해🤍 내일 봐",
          "time": "17:28"
        },
        {
          "id": "410ffc2d-8c14-4428-ba04-7ffc89aedcd8",
          "kind": "date",
          "text": "2026년 4월 22일 수요일",
          "dateParts": {
            "mode": "calendar",
            "year": 2026,
            "month": 4,
            "day": 22,
            "weekday": 3
          }
        },
        {
          "id": "81805503-ab49-4a09-b396-f2de467deb71",
          "from": "me",
          "text": "컴백 축하해~",
          "time": "17:32"
        },
        {
          "id": "c4ee69b9-3411-465e-ab5a-2d608d209f27",
          "from": "them",
          "text": "댓글 뭐예요ㅋㅋㅋ",
          "time": "17:32"
        },
        {
          "id": "ee59842a-b531-46ef-b229-2a1ad3760b35",
          "from": "them",
          "text": "팬분들이 오해해요",
          "time": "17:33"
        },
        {
          "id": "263da521-f779-4655-9be4-42bea6180d48",
          "from": "me",
          "text": "뭐 어때",
          "time": "17:34"
        },
        {
          "id": "25ed26d9-9715-4afc-98e9-e8d02f092106",
          "kind": "date",
          "text": "2026년 6월 2일 화요일",
          "dateParts": {
            "mode": "calendar",
            "year": 2026,
            "month": 6,
            "day": 2,
            "weekday": 2
          }
        },
        {
          "id": "6d0c33db-a154-43e2-b164-a8d2f7b1a40b",
          "from": "them",
          "text": "옛날 생각난다...",
          "time": "17:35"
        },
        {
          "id": "3813f3be-a8c7-49b6-9377-0d887fdd0fd3",
          "from": "me",
          "text": "그러게 ㅎㅎ 시간 진짜 빠르다",
          "time": "17:35"
        },
        {
          "id": "33f7ccb0-cdaa-46a6-a7f9-6305c3573840",
          "kind": "date",
          "text": "2026년 10월 7일 수요일",
          "dateParts": {
            "mode": "calendar",
            "year": 2026,
            "month": 10,
            "day": 7,
            "weekday": 3
          }
        },
        {
          "id": "5bdda8e6-fa5a-4b30-b490-c3bff0df7898",
          "from": "them",
          "text": "컴백 축하해요! 음방에서 봐요ㅎㅎ",
          "time": "17:37"
        },
        {
          "id": "ac85daed-46dc-47d4-8c4f-d3dfd2952c30",
          "from": "me",
          "text": "재환이도 컴백 축하해~",
          "time": "17:37"
        },
        {
          "id": "6ab6c62e-4a3e-4912-a6c5-a04807b0400f",
          "kind": "date",
          "text": "2026년 10월 11일 일요일",
          "dateParts": {
            "mode": "calendar",
            "year": 2026,
            "month": 10,
            "day": 11,
            "weekday": 0
          }
        },
        {
          "id": "1bd4d1fc-5e2a-48af-9340-98cd5326ad7f",
          "from": "them",
          "text": "오늘 형 때문에 떨려서 노래가 안 됐어요ㅋㅋㅋ",
          "time": "17:39"
        },
        {
          "id": "82a0e6c9-c5e5-41dd-a05c-55901658de5a",
          "from": "me",
          "text": "새삼스럽네",
          "time": "17:39"
        }
